# Copy to .env and fill in for dev tooling

# CMake toolchain file of the Qt kit to build with, for a new build folder
# Used by `build`, and by `test --build`. Without it, CMake finds Qt itself
QT_TOOLCHAIN_FILE=

# Path for long-term cached files, like downloaded icon packs
# Used by `icons` unless `--work-dir` is set
CACHE_DIR=
